# PostHog product analytics — required for telemetry.
# Get the project API key from https://us.posthog.com → Project Settings.
# EXPO_PUBLIC_ vars are inlined at build time, so you also need to add these
# to Vercel's Environment Variables (Project Settings → Environment Variables)
# for the deployed web build, and to EAS Secrets for production iOS/Android.
EXPO_PUBLIC_POSTHOG_KEY=phc_replace_me
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase leaderboard backend (publishable values — safe in client).
# Falls back to the live SideProjects project if these aren't set.
EXPO_PUBLIC_SUPABASE_URL=https://vigbcnztxhgwduxexkwb.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_Xi5dxHbQleYkxwGUOBfaEg_ZqJy0VPg
